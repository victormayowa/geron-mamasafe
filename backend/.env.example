# Application Settings
APP_NAME=Geron Mamasafe Health AI
APP_VERSION=1.0.0
DEBUG=True

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/geron_mamasafe
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/geron_mamasafe

# Redis
REDIS_URL=redis://localhost:6379/0

# Twilio WhatsApp/SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_PHONE_NUMBER=+1234567890

# AI Configuration - FREE OPTIONS AVAILABLE

# Option 1: Groq (FREE TIER - RECOMMENDED - Fast & Free)
# Get free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Option 2: Ollama (LOCAL - Completely Free, No API Key)
# Install: https://ollama.ai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Option 3: HuggingFace (FREE TIER)
# Get free key at: https://huggingface.co
HUGGINGFACE_API_KEY=your_huggingface_api_key
HUGGINGFACE_MODEL=microsoft/Phi-3-mini-4k-instruct

# Option 4: OpenAI (PAID)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4

# Active AI Provider (groq, ollama, huggingface, openai)
AI_PROVIDER=groq

# JWT Authentication
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Daily Message Schedule
DAILY_MESSAGE_HOUR=8
DAILY_MESSAGE_TIMEZONE=Africa/Lagos

# Health Center Settings
DEFAULT_HEALTH_CENTER_ID=1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
